{
  "name": "@swv/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "measure": "playwright test --project=measure",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --build --noEmit",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:check": "oxlint . --deny-warnings && eslint . --max-warnings 0",
    "format": "prettier --write src/ e2e/",
    "format:check": "prettier --check src/ e2e/",
    "contract:lint": "redocly lint ../../contracts/openapi.yaml --config ../../contracts/redocly.yaml",
    "contract:types": "openapi-typescript ../../contracts/openapi.yaml -o src/main/lib/api/schema.ts",
    "contract:docs": "redocly build-docs ../../contracts/openapi.yaml --config ../../contracts/redocly.yaml -o ../../contracts/dist/index.html",
    "contract:bundle": "redocly bundle ../../contracts/openapi.yaml --config ../../contracts/redocly.yaml -o ../../contracts/dist/swagger/openapi.json",
    "contract:swagger": "pnpm run contract:bundle && node scripts/build-swagger-ui.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.49.0",
    "@swv/data": "workspace:*",
    "@swv/solver": "workspace:*",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highs": "1.15.3",
    "pinia": "4.0.3",
    "reka-ui": "2.10.5",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.57.0",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "catalog:",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "swagger-ui-dist": "5.33.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.3.2",
    "vitest": "catalog:",
    "vue-tsc": "3.3.11"
  }
}
