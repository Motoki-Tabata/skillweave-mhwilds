{
  "name": "skillweave",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  // 最初から skillweave.app だけで公開する（028 decisions.md Q83）。
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "skillweave.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // /builds などの直接アクセスは index.html を返す（vue-router の history モード）。
    "not_found_handling": "single-page-application",
    // /api/* は静的ファイルや index.html にせず、必ず Worker で扱う。
    "run_worker_first": ["/api/*"],
  },
}
