{
  "name": "skillweave-mhwilds",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "type-check": "pnpm -r run type-check",
    "test:unit": "pnpm -r run test:unit",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "pnpm -r run lint",
    "lint:check": "pnpm -r run lint:check",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "contract:lint": "pnpm --filter @swv/web run contract:lint",
    "contract:types": "pnpm --filter @swv/web run contract:types",
    "contract:docs": "pnpm --filter @swv/web run contract:docs",
    "contract:swagger": "pnpm --filter @swv/web run contract:swagger"
  }
}
